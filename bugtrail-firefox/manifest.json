{
  "manifest_version": 2,
  "name": "BugTrail — Authorized Research Console",
  "version": "0.3.1",
  "description": "Local-first IDOR / access-control testing workspace for authorized security research.",
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "tabs",
    "webRequest"
  ],
  "optional_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "page": "background.html"
  },
  "browser_action": {
    "default_title": "BugTrail",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "app.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    "page-hook.js"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "bugtrail@example.local"
    }
  }
}